ARGUS_ENV=development
# Use nomes de volumes Docker ou caminhos absolutos no host.
ARGUS_DATA_ROOT=docker
ARGUS_POSTGRES_DATA_PATH=postgres-data
ARGUS_CLICKHOUSE_DATA_PATH=clickhouse-data
ARGUS_COLLECTOR_DATA_PATH=collector-data
ARGUS_BACKUP_DATA_PATH=backup-data
ARGUS_TENANT_BACKUP_DATA_PATH=tenant-backup-data
ARGUS_BACKUP_STAGING_DATA_PATH=backup-staging-data
ARGUS_PROXY_DATA_PATH=proxy-data
ARGUS_PROXY_CONFIG_PATH=proxy-config
ARGUS_API_BIND=127.0.0.1
ARGUS_WEB_BIND=127.0.0.1
ARGUS_HTTP_BIND=0.0.0.0
ARGUS_HTTPS_BIND=0.0.0.0
ARGUS_COLLECTOR_BIND=127.0.0.1
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8080
ARGUS_POSTGRES_PASSWORD=argus
ARGUS_POSTGRES_URL=postgres://argus:argus@postgres:5432/argus
ARGUS_CLICKHOUSE_URL=http://clickhouse:8123
ARGUS_CLICKHOUSE_USER=argus
ARGUS_CLICKHOUSE_PASSWORD=change-me
ARGUS_CLICKHOUSE_DATABASE=argus
ARGUS_COLLECTOR_ID=00000000-0000-0000-0000-000000000001
ARGUS_TENANT_ID=00000000-0000-0000-0000-000000000001
ARGUS_SESSION_TTL_HOURS=12
# URL acessível pelos usuários; usada nos links de recuperação de senha.
ARGUS_PUBLIC_URL=http://localhost
# O proxy integrado publica 80/TCP e 443/TCP; o SSH normalmente usa 22/TCP.
ARGUS_FIREWALL_SERVER_NAME=Servidor principal · DC-A
# Caddy emite e renova o certificado automaticamente quando o domínio aponta
# para esta VM e 80/TCP e 443/TCP chegam até ela.
ARGUS_TLS_DOMAIN=
ARGUS_TLS_EMAIL=
ARGUS_TLS_CHALLENGE=disabled
ARGUS_PROXY_CONFIG=Caddyfile.http
ARGUS_PASSWORD_RESET_TTL_MINUTES=30
# Recuperação por e-mail. Pode usar o SMTP já existente do provedor.
ARGUS_SMTP_HOST=
ARGUS_SMTP_PORT=587
ARGUS_SMTP_SECURE=false
ARGUS_SMTP_USER=
ARGUS_SMTP_PASSWORD=
ARGUS_SMTP_FROM=LogVault <logvault@provedor.com.br>
# Use true quando o painel estiver publicado exclusivamente em HTTPS.
ARGUS_COOKIE_SECURE=false
ARGUS_BOOTSTRAP_ADMIN_NAME=Administrador
ARGUS_BOOTSTRAP_ADMIN_EMAIL=admin@argus.local
ARGUS_BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-forte-com-12-ou-mais-caracteres
ARGUS_DEVICE_ID=00000000-0000-0000-0000-000000000001
ARGUS_DEVICE_VENDOR=a10
ARGUS_DEVICE_TIMEZONE=America/Sao_Paulo
# Opcional: permite vários equipamentos no mesmo coletor, resolvidos pelo IP de origem UDP.
# Mantenha em uma única linha no arquivo .env.
ARGUS_DEVICES_JSON=[]
ARGUS_SPOOL_PATH=/var/lib/argus/spool.sqlite
ARGUS_NETFLOW_HOST=0.0.0.0
ARGUS_NETFLOW_PORT=2055
ARGUS_SYSLOG_HOST=0.0.0.0
ARGUS_SYSLOG_PORT=5140
# Eventos A10 destes protocolos são descartados antes do spool.
ARGUS_A10_IGNORED_PROTOCOLS=GRE,ESP
ARGUS_SYNC_URL=http://api:8080/v1/ingest/batches
ARGUS_HEARTBEAT_URL=http://api:8080/v1/ingest/heartbeat
# Chave individual deste coletor. Novas chaves são exibidas uma única vez na tela Coletores.
ARGUS_SYNC_TOKEN=change-me
# Preenchido somente no coletor local quando a nova redundância estiver ativa.
ARGUS_SECONDARY_SYNC_URL=
ARGUS_SECONDARY_HEARTBEAT_URL=
ARGUS_SECONDARY_SYNC_TOKEN=
# Chave independente recomendada para criptografar URLs/tokens de alertas (mínimo 32 caracteres).
# Quando vazia, o ambiente atual usa ARGUS_SYNC_TOKEN como chave de compatibilidade.
ARGUS_ALERT_ENCRYPTION_KEY=
ARGUS_COLLECTOR_VERSION=0.1.0
ARGUS_HEARTBEAT_INTERVAL_MS=10000
ARGUS_SYNC_BATCH_SIZE=5000
ARGUS_SYNC_INTERVAL_MS=1000
ARGUS_SYNC_MAX_BATCHES_PER_TICK=4
ARGUS_EDGE_ACK_RETENTION_HOURS=24
# Somente no coletor que roda junto ao servidor principal.
ARGUS_MANAGED_CLOUD_ENABLED=true
ARGUS_MANAGED_CLOUD_REGISTRY_URL=http://api:8080/v1/ingest/managed-cloud/registry
ARGUS_MANAGED_CLOUD_PORT_START=30000
ARGUS_MANAGED_CLOUD_PORT_END=31999
ARGUS_MANAGED_CLOUD_SECONDARY_PORT_START=32000
ARGUS_MANAGED_CLOUD_SECONDARY_PORT_END=33999
# Backups locais automáticos. Copie o volume para outro host para proteção contra perda da VM.
ARGUS_BACKUP_INTERVAL_HOURS=24
ARGUS_BACKUP_RETENTION_DAYS=15
ARGUS_BACKUP_FULL_INTERVAL_DAYS=7
# Opcional: segunda cópia via SSH/rsync. O diretório remoto deve existir.
# Também monte a chave privada e o known_hosts no serviço backup em /run/secrets.
ARGUS_BACKUP_REMOTE_TARGET=
ARGUS_BACKUP_REMOTE_PORT=22
# Janela máxima sem internet usada para dimensionar o spool do coletor.
ARGUS_CAPACITY_OFFLINE_HOURS=6
# Nova redundância. O instalador do secundário preenche estes valores após o pareamento.
ARGUS_REDUNDANCY_ROLE=standalone
ARGUS_REDUNDANCY_SITE_ID=
ARGUS_REDUNDANCY_PRIMARY_SITE_ID=
ARGUS_REDUNDANCY_SITE_NAME=Servidor principal
ARGUS_REDUNDANCY_PRIMARY_URL=
ARGUS_REDUNDANCY_SITE_TOKEN=
ARGUS_REDUNDANCY_SYNC_INTERVAL_MS=15000
# Canal local restrito usado pelo painel para solicitar a preparação do DC-A.
ARGUS_CONTINUITY_CONTROL_PATH=/var/lib/logvault/control
# Continuidade/DR. Enquanto false, o painel informa "não configurado" sem gerar alertas.
ARGUS_DR_ENABLED=false
ARGUS_DR_PREPARED=false
ARGUS_DR_LOCAL_SITE=a
ARGUS_DR_LOCAL_HOSTNAME=logvault-dc-a
# IP local da interface de replicação. Para endereços públicos, use uma VPN
# ou túnel entre os dois sites; PostgreSQL/ClickHouse não devem ficar públicos.
ARGUS_DR_REPLICATION_BIND=127.0.0.1
ARGUS_DR_REPLICATION_CIDR=127.0.0.1/32
ARGUS_DR_POSTGRES_REPLICATION_PASSWORD=
ARGUS_DR_POSTGRES_WAL_KEEP_SIZE=2GB
ARGUS_DR_SITE_A_HOST=
ARGUS_DR_PANEL_HOST=localhost
ARGUS_DR_INGEST_HOST=localhost
ARGUS_DR_CONTROL_HOST=localhost
ARGUS_DR_DNS_PROVIDER=manual
ARGUS_DR_DNS_TTL_SECONDS=300
ARGUS_DR_SITE_A_NAME=Data Center A
ARGUS_DR_SITE_B_NAME=Data Center B
# Endpoints internos alcançáveis pela API do site A por DNS estável. Nunca são devolvidos ao navegador.
ARGUS_DR_POSTGRES_STANDBY_URL=
ARGUS_DR_CLICKHOUSE_STANDBY_URL=
ARGUS_DR_CLICKHOUSE_STANDBY_USER=argus
ARGUS_DR_CLICKHOUSE_STANDBY_PASSWORD=
ARGUS_DR_STANDBY_API_URL=
ARGUS_DR_LAG_WARNING_SECONDS=10
ARGUS_DR_LAG_CRITICAL_SECONDS=60
# Origem usada pelo instalador do DC-B.
ARGUS_DR_REPOSITORY_URL=https://github.com/cassianotb/logvault.git
ARGUS_DR_REPOSITORY_REF=main
