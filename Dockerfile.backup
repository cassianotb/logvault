FROM postgres:17-alpine

RUN apk add --no-cache coreutils curl flock jq openssh-client rsync sqlite zstd

COPY scripts/backup-once.sh scripts/backup-loop.sh scripts/backup-mirror.sh /usr/local/bin/
RUN chmod 0755 /usr/local/bin/backup-once.sh /usr/local/bin/backup-loop.sh /usr/local/bin/backup-mirror.sh

ENTRYPOINT ["/usr/local/bin/backup-loop.sh"]
